# ── Banco (Prisma) ───────────────────────────────────────────────────────
# Supabase > botão "Connect" > aba "ORMs" > Prisma. Troque [YOUR-PASSWORD] pela senha do banco.
# App (pooler "transaction", porta 6543):
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-REGIAO.pooler.supabase.com:6543/postgres"
# Migrações (pooler "session", porta 5432):
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-REGIAO.pooler.supabase.com:5432/postgres"

# Supabase > Project Settings > API (as mesmas do frontend)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Endereço(s) do frontend que podem chamar a API, separados por vírgula
FRONTEND_URL=http://localhost:3000

PORT=4000
